# Merry Team — Office Attendance Bot

# Telegram bot token (BotFather se)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Comma-separated Telegram user IDs jinhe naye registration ki notification milti hai
ADMIN_IDS=123456789,987654321

# Web admin login (pehli baar auto-create hota hai; baad me CLI se manage karein)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
SECRET_KEY=change-this-long-random-string

# Timezone (default: Asia/Kolkata)
TIMEZONE=Asia/Kolkata

# SQLite file ka rasta. Render par persistent disk ke liye /data/attendance.db
DB_PATH=attendance.db
